    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "content:build": "content-collections build",
    "content:import": "tsx scripts/content/import/cli.ts --apply --from-local C:/Users/victo/Downloads/ai-learning-sources",
    "content:check": "tsx scripts/content/import/cli.ts --check --from-local C:/Users/victo/Downloads/ai-learning-sources"
  },
